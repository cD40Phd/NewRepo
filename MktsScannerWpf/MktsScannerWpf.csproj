<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- .NET Framework 4.6.2: запускается на Windows 7–11 без установки .NET 8. -->
		<TargetFramework>net462</TargetFramework>
		<LangVersion>12</LangVersion>
		<Nullable>enable</Nullable>
		<RootNamespace>MktsScannerWpf</RootNamespace>
		<AssemblyName>MktsScannerWpf</AssemblyName>
		<!-- Окно описано в коде без XAML, поэтому проект собирается и без WindowsDesktop SDK. -->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
		<Reference Include="PresentationCore" />
		<Reference Include="PresentationFramework" />
		<Reference Include="WindowsBase" />
		<Reference Include="System.Xaml" />
	</ItemGroup>

	<ItemGroup>
		<!-- Общий код опроса Modbus RTU с консольной версией. -->
		<Compile Include="..\MktsScanner\ModbusRtu.cs" Link="Shared\ModbusRtu.cs" />
		<Compile Include="..\MktsScanner\BusScanner.cs" Link="Shared\BusScanner.cs" />
		<Compile Include="..\MktsScanner\Polyfills.cs" Link="Shared\Polyfills.cs" />
	</ItemGroup>

</Project>
