<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<!-- net462 — для промышленных ПК (Windows 7 и новее): .NET Framework 4.6.2+ уже есть в системе
		     или ставится одним пакетом, отдельный рантайм .NET 8 не нужен. -->
		<TargetFrameworks>net462;net8.0</TargetFrameworks>
		<LangVersion>12</LangVersion>
		<Nullable>enable</Nullable>
		<RootNamespace>MktsScanner</RootNamespace>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net462'">
		<!-- Позволяет собирать net462 без установленного Developer Pack (в т.ч. на Linux). -->
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="System.IO.Ports" Version="8.0.0" />
	</ItemGroup>

</Project>
