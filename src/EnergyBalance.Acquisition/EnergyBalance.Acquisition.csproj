<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EnergyBalance.Acquisition</RootNamespace>
    <!-- Прямой опрос последовательных портов требует Windows/Linux hosting с доступом к COM/tty -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="NModbus" Version="3.0.83" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.378.156" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnergyBalance.Domain\EnergyBalance.Domain.csproj" />
    <ProjectReference Include="..\EnergyBalance.DataAccess\EnergyBalance.DataAccess.csproj" />
  </ItemGroup>

</Project>
