<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TypeStrike</RootNamespace>
    <AssemblyName>TypeStrike</AssemblyName>
    <!-- Позволяет собирать проект и на не-Windows машинах (запуск — только на Windows) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Words\en.txt" LogicalName="Words.en.txt" />
    <EmbeddedResource Include="Words\ru.txt" LogicalName="Words.ru.txt" />
  </ItemGroup>

</Project>
