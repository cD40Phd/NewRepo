<Window x:Class="TypeStrike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:game="clr-namespace:TypeStrike.Game"
        Title="TypeStrike — космический тренажёр скоростной печати"
        Width="1200" Height="820" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#03040C"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput">
    <Window.Resources>
        <!-- Анимация предупреждения: глаз поднимает взгляд, стрелка зовёт наверх, текст пульсирует -->
        <Storyboard x:Key="GazeWarnStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="IrisShift" Storyboard.TargetProperty="Y"
                             From="26" To="-20" Duration="0:0:0.9" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ArrowShift" Storyboard.TargetProperty="Y"
                             From="18" To="-12" Duration="0:0:0.6" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GazeWarnText" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.35" Duration="0:0:0.5" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GazeWarnScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.06" Duration="0:0:0.5" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GazeWarnScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.06" Duration="0:0:0.5" AutoReverse="True" />
        </Storyboard>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <game:GameView x:Name="View" Focusable="True" FocusVisualStyle="{x:Null}" />
        <!-- Подсказка: слово, клавиатура с зонами пальцев, руки -->
        <game:KeyboardHint x:Name="Hints" Grid.Row="1" Height="230" Visibility="Collapsed" />

        <!-- Предпросмотр камеры (контроль взгляда) -->
        <Border x:Name="CameraPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,90,16,0"
                Background="#CC070A18" BorderBrush="#2B3D5E" BorderThickness="1" CornerRadius="8" Padding="6"
                Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel Width="160">
                <Image x:Name="CameraImage" Height="120" Stretch="Uniform" />
                <TextBlock x:Name="CameraStatus" FontFamily="Consolas" FontSize="12" Foreground="#C8D3EA"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="F5 — перекалибровать" FontFamily="Consolas" FontSize="11"
                           Foreground="{StaticResource DimBrush}" />
            </StackPanel>
        </Border>

        <!-- ───────── Главное меню ───────── -->
        <ScrollViewer x:Name="MenuPanel" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" Focusable="False">
        <Border Style="{StaticResource PanelStyle}" Width="560" Margin="20">
            <StackPanel>
                <TextBlock Text="TYPESTRIKE" FontFamily="Consolas" FontSize="56" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#5CE1FF" BlurRadius="24" ShadowDepth="0" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="космический тренажёр скоростной печати" FontFamily="Consolas" FontSize="15"
                           Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />

                <TextBlock Style="{StaticResource CaptionStyle}" Text="РЕЖИМ" />
                <UniformGrid Columns="2">
                    <RadioButton x:Name="ModeLessons" GroupName="Mode" Style="{StaticResource ChipStyle}"
                                 Content="Уроки слепой печати" IsChecked="True" Click="Mode_Click" />
                    <RadioButton x:Name="ModeFree" GroupName="Mode" Style="{StaticResource ChipStyle}"
                                 Content="Свободная игра" Click="Mode_Click" />
                </UniformGrid>

                <TextBlock Style="{StaticResource CaptionStyle}" Text="СЛОВА" />
                <UniformGrid Columns="3">
                    <RadioButton x:Name="LangEn" GroupName="Lang" Style="{StaticResource ChipStyle}"
                                 Content="English" Click="Lang_Click" />
                    <RadioButton x:Name="LangRu" GroupName="Lang" Style="{StaticResource ChipStyle}"
                                 Content="Русский" IsChecked="True" Click="Lang_Click" />
                    <RadioButton x:Name="LangCustom" GroupName="Lang" Style="{StaticResource ChipStyle}"
                                 Content="Свой файл…" Click="LangCustom_Click" />
                </UniformGrid>
                <TextBlock x:Name="CustomInfo" Visibility="Collapsed" FontFamily="Consolas" FontSize="13"
                           Foreground="{StaticResource OrangeBrush}" Margin="4,4,0,0" TextTrimming="CharacterEllipsis" />

                <Border x:Name="LessonPanel" Margin="0,12,0,0" Padding="12,10" CornerRadius="8"
                        Background="#111A2E" BorderBrush="#2B3D5E" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource NeonButton}" FontSize="16"
                                    Padding="12,4" Margin="0" Content="◀" Click="LessonPrev_Click" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource NeonButton}" FontSize="16"
                                    Padding="12,4" Margin="0" Content="▶" Click="LessonNext_Click" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="LessonTitle" FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock x:Name="LessonLetters" FontFamily="Consolas" FontSize="13"
                                           Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="LessonStars" FontFamily="Consolas" FontSize="20"
                                   Foreground="{StaticResource OrangeBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock x:Name="LessonTip" FontFamily="Consolas" FontSize="13" Foreground="#C8D3EA"
                                   TextWrapping="Wrap" Margin="0,6,0,0" TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource CaptionStyle}" Text="СЛОЖНОСТЬ" />
                <UniformGrid Columns="3">
                    <RadioButton x:Name="DiffEasy" GroupName="Diff" Style="{StaticResource ChipStyle}"
                                 Content="Лёгкая" Click="Difficulty_Click" />
                    <RadioButton x:Name="DiffNormal" GroupName="Diff" Style="{StaticResource ChipStyle}"
                                 Content="Нормальная" IsChecked="True" Click="Difficulty_Click" />
                    <RadioButton x:Name="DiffHard" GroupName="Diff" Style="{StaticResource ChipStyle}"
                                 Content="Хардкор" Click="Difficulty_Click" />
                </UniformGrid>
                <TextBlock x:Name="DifficultyInfo" FontFamily="Consolas" FontSize="13"
                           Foreground="{StaticResource DimBrush}" Margin="4,4,0,0" />

                <Button Style="{StaticResource NeonButton}" Margin="0,20,0,6" Click="Start_Click"
                        Content="▶  СТАРТ   [Enter]" />
                <Button x:Name="ContinueButton" Style="{StaticResource NeonButton}" Click="Continue_Click"
                        Visibility="Collapsed" />
                <Button Style="{StaticResource NeonButton}" Click="Settings_Click" FontSize="17"
                        Content="⚙  НАСТРОЙКИ И КАМЕРА   [F2]" />
                <TextBlock x:Name="BestText" FontFamily="Consolas" FontSize="14" Foreground="{StaticResource OrangeBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />

                <Border Height="1" Background="#2B3D5E" Margin="0,18,0,12" />
                <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{StaticResource DimBrush}"
                           TextWrapping="Wrap" LineHeight="20">
                    <Run Text="Сбивайте вражеские корабли, печатая слова на них. Первая буква захватывает ближайшую цель — допечатайте слово до конца, не промахиваясь." />
                    <LineBreak />
                    <Run Text="Уроки: 4 волны, первая — упражнения на новые буквы, дальше слова из изученных букв. Скорость не важна — нужна точность 98–100% (★ 98%, ★★ 99%, ★★★ 100%). Новая буква открывается после 3 зачётов подряд со стабильной скоростью." />
                    <LineBreak />
                    <Run Foreground="White" Text="Enter" /><Run Text=" — ЭМИ-импульс (отталкивает врагов)   " />
                    <Run Foreground="White" Text="Backspace" /><Run Text=" — сменить цель   " />
                    <Run Foreground="White" Text="Esc" /><Run Text=" — пауза" />
                </TextBlock>
            </StackPanel>
        </Border>
        </ScrollViewer>

        <!-- ───────── Настройки ───────── -->
        <ScrollViewer x:Name="SettingsPanel" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="Collapsed">
        <Border Style="{StaticResource PanelStyle}" Width="680" Margin="20">
            <StackPanel>
                <TextBlock Text="НАСТРОЙКИ" FontFamily="Consolas" FontSize="40" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />

                <TextBlock Style="{StaticResource CaptionStyle}" Text="РАЗМЕР БУКВ" />
                <UniformGrid Columns="3">
                    <RadioButton x:Name="SizeNormal" GroupName="Size" Style="{StaticResource ChipStyle}"
                                 Content="Обычные" Click="TextSize_Click" />
                    <RadioButton x:Name="SizeLarge" GroupName="Size" Style="{StaticResource ChipStyle}"
                                 Content="Крупные" Click="TextSize_Click" />
                    <RadioButton x:Name="SizeHuge" GroupName="Size" Style="{StaticResource ChipStyle}"
                                 Content="Очень крупные" Click="TextSize_Click" />
                </UniformGrid>
                <Border Background="#C0080C1E" CornerRadius="6" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Center">
                    <TextBlock x:Name="SizePreview" FontFamily="Consolas" FontWeight="Bold" Foreground="#F2F6FF">
                        <Run Foreground="#FF9F1C" Text="кос" /><Run Text="мос" />
                    </TextBlock>
                </Border>

                <TextBlock Style="{StaticResource CaptionStyle}" Text="ИГРА" />
                <CheckBox x:Name="HintsBox" Content="Подсказка: слово, клавиатура и пальцы" Focusable="False"
                          Foreground="#C8D3EA" FontFamily="Consolas" FontSize="15" Margin="4,2" Click="SettingsChanged" />
                <CheckBox x:Name="SoundBox" Content="Звуковые эффекты" Focusable="False"
                          Foreground="#C8D3EA" FontFamily="Consolas" FontSize="15" Margin="4,2" Click="SettingsChanged" />

                <TextBlock Style="{StaticResource CaptionStyle}" Text="КАМЕРА — КОНТРОЛЬ ВЗГЛЯДА" />
                <CheckBox x:Name="CameraBox" Focusable="False" Foreground="#C8D3EA" FontFamily="Consolas"
                          FontSize="15" Margin="4,2" Click="CameraBox_Click">
                    <TextBlock TextWrapping="Wrap">
                        Следить, чтобы взгляд не уходил на клавиатуру
                        <Run Foreground="#8FA3C7" FontSize="12" Text="(кадры не сохраняются)" />
                    </TextBlock>
                </CheckBox>

                <StackPanel x:Name="CameraSettings">
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="Камера:" FontFamily="Consolas" FontSize="14" Foreground="{StaticResource DimBrush}"
                                   VerticalAlignment="Center" Margin="4,0,10,0" />
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="Cam1" GroupName="Cam" Style="{StaticResource ChipStyle}" Content="№ 1" Click="CameraIndex_Click" />
                            <RadioButton x:Name="Cam2" GroupName="Cam" Style="{StaticResource ChipStyle}" Content="№ 2" Click="CameraIndex_Click" />
                            <RadioButton x:Name="Cam3" GroupName="Cam" Style="{StaticResource ChipStyle}" Content="№ 3" Click="CameraIndex_Click" />
                        </UniformGrid>
                    </DockPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="320" Height="240" Background="#05070F" BorderBrush="#2B3D5E" BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <TextBlock Text="нет изображения" FontFamily="Consolas" FontSize="13"
                                           Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="SettingsCameraImage" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock x:Name="SettingsCameraStatus" FontFamily="Consolas" FontSize="17" FontWeight="Bold"
                                       Foreground="#C8D3EA" TextWrapping="Wrap" />
                            <TextBlock Text="Наклон головы" FontFamily="Consolas" FontSize="13"
                                       Foreground="{StaticResource DimBrush}" Margin="0,12,0,3" />
                            <Grid x:Name="DropBar" Height="14" Background="#141B2B">
                                <Rectangle x:Name="DropFill" HorizontalAlignment="Left" Width="0" Fill="#5CE1FF" />
                                <Rectangle x:Name="DropMarker" HorizontalAlignment="Left" Width="3" Fill="#FF9F1C" />
                            </Grid>
                            <TextBlock x:Name="MetricsText" FontFamily="Consolas" FontSize="13" Foreground="#C8D3EA"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="Куда вы смотрите (рамка — экран)" FontFamily="Consolas" FontSize="13"
                                       Foreground="{StaticResource DimBrush}" Margin="0,10,0,3" />
                            <Canvas x:Name="GazeMap" Width="200" Height="130" Background="#05070F" HorizontalAlignment="Left">
                                <Rectangle Canvas.Left="30" Canvas.Top="15" Width="140" Height="80"
                                           Stroke="#5CE1FF" StrokeThickness="1.5" />
                                <TextBlock Canvas.Left="62" Canvas.Top="108" Text="клавиатура" FontFamily="Consolas"
                                           FontSize="11" Foreground="{StaticResource DimBrush}" />
                                <Ellipse x:Name="GazeDot" Width="12" Height="12" Fill="#FF9F1C" Visibility="Hidden" />
                            </Canvas>
                            <Button Style="{StaticResource NeonButton}" FontSize="16" Margin="0,12,0,0"
                                    Content="◎  КАЛИБРОВКА ВЗГЛЯДА" Click="Calibrate_Click" />
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,14,0,0">
                        <TextBlock x:Name="SensitivityText" DockPanel.Dock="Top" FontFamily="Consolas" FontSize="14"
                                   Foreground="#C8D3EA" Margin="4,0,0,4" />
                        <TextBlock DockPanel.Dock="Left" Text="ниже" FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="4,0,8,0" />
                        <TextBlock DockPanel.Dock="Right" Text="выше" FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Slider x:Name="SensitivitySlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                Focusable="False" ValueChanged="Sensitivity_Changed" />
                    </DockPanel>
                    <CheckBox x:Name="UseEyesBox" Content="Учитывать глаза (веки прикрываются, когда смотрят вниз)"
                              Focusable="False" Foreground="#C8D3EA" FontFamily="Consolas" FontSize="14" Margin="4,8,0,2"
                              Click="CameraOption_Click" />
                    <CheckBox x:Name="CalibrateEachGameBox" Content="Калибровать в начале каждой игры"
                              Focusable="False" Foreground="#C8D3EA" FontFamily="Consolas" FontSize="14" Margin="4,2"
                              Click="CameraOption_Click" />

                    <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{StaticResource DimBrush}"
                               TextWrapping="Wrap" LineHeight="19" Margin="4,10,0,0">
                        <Run Foreground="White" Text="Как настроить:" />
                        <LineBreak />
                        <Run Text="1. Сядьте как при игре, пальцы на основном ряду. Нажмите «Калибровка взгляда» и следите глазами за летающей точкой (~20 секунд), голову держите ровно." />
                        <LineBreak />
                        <Run Text="2. Проверка: смотрите в разные места экрана — оранжевая точка на схеме должна ходить внутри рамки. Посмотрите на клавиатуру — точка уйдёт вниз, статус сменится на «взгляд не на экране»." />
                        <LineBreak />
                        <Run Text="3. Не срабатывает — повысьте чувствительность. Срабатывает зря — понизьте её, отключите учёт глаз или откалибруйтесь при лучшем свете." />
                    </TextBlock>
                </StackPanel>

                <Button Style="{StaticResource NeonButton}" Margin="0,20,0,0" Content="ГОТОВО  [Esc]"
                        Click="SettingsDone_Click" />
            </StackPanel>
        </Border>
        </ScrollViewer>

        <!-- ───────── Калибровка взгляда ───────── -->
        <Grid x:Name="CalibrationLayer" Grid.RowSpan="2" Background="#F705070F" Visibility="Collapsed">
            <Canvas x:Name="CalibCanvas">
                <Ellipse x:Name="CalibGlow" Width="90" Height="90" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#90FF9F1C" Offset="0" />
                            <GradientStop Color="#00FF9F1C" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="CalibDot" Width="34" Height="34" Fill="#FF9F1C" Stroke="White" StrokeThickness="3" />
                <Ellipse x:Name="CalibCenter" Width="8" Height="8" Fill="#05070F" />
            </Canvas>
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0" IsHitTestVisible="False">
                <TextBlock x:Name="CalibTitle" FontFamily="Consolas" FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock x:Name="CalibInfo" FontFamily="Consolas" FontSize="17" Foreground="#C8D3EA"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="760" Margin="0,8,0,0" />
            </StackPanel>
            <Grid VerticalAlignment="Bottom" Height="6" Background="#141B2B">
                <Rectangle x:Name="CalibProgress" HorizontalAlignment="Left" Width="0" Fill="#5CE1FF" />
            </Grid>
        </Grid>

        <!-- ───────── Пауза: взгляд ушёл с экрана ───────── -->
        <Grid x:Name="GazePausePanel" Grid.RowSpan="2" Background="#E6050712" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path x:Name="GazeArrow" Data="M 0,34 L 30,0 L 60,34 M 30,0 L 30,70" Stroke="{StaticResource OrangeBrush}"
                      StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="ArrowShift" />
                    </Path.RenderTransform>
                </Path>
                <Canvas Width="240" Height="140" HorizontalAlignment="Center">
                    <Canvas.Clip>
                        <PathGeometry Figures="M 10,70 Q 120,-10 230,70 Q 120,150 10,70 Z" />
                    </Canvas.Clip>
                    <Path Data="M 10,70 Q 120,-10 230,70 Q 120,150 10,70 Z" Fill="#EAF2FF" />
                    <Canvas>
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="IrisShift" />
                        </Canvas.RenderTransform>
                        <Ellipse Canvas.Left="88" Canvas.Top="38" Width="64" Height="64" Fill="#2B7FD6" />
                        <Ellipse Canvas.Left="106" Canvas.Top="56" Width="28" Height="28" Fill="#05070F" />
                        <Ellipse Canvas.Left="122" Canvas.Top="58" Width="9" Height="9" Fill="White" />
                    </Canvas>
                    <Path Data="M 10,70 Q 120,-10 230,70 Q 120,150 10,70 Z" Stroke="{StaticResource AccentBrush}"
                          StrokeThickness="5" />
                </Canvas>
                <TextBlock x:Name="GazeWarnText" Text="ПОДНИМИТЕ ГЛАЗА НА ЭКРАН" FontFamily="Consolas" FontSize="42"
                           FontWeight="Bold" Foreground="{StaticResource OrangeBrush}" HorizontalAlignment="Center"
                           Margin="0,26,0,0" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="GazeWarnScale" />
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock FontFamily="Consolas" FontSize="17" Foreground="#C8D3EA" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="640" Margin="0,12,0,0"
                           Text="Не смотрите на клавиатуру — пальцы найдут клавиши сами. Игра продолжится, как только взгляд вернётся на экран." />
                <TextBlock x:Name="GazeResumeText" FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                           Foreground="#6BFFB0" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="Esc — обычная пауза" FontFamily="Consolas" FontSize="13"
                           Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>

        <!-- ───────── Пауза ───────── -->
        <Border x:Name="PausePanel" Grid.RowSpan="2" Style="{StaticResource PanelStyle}" Width="380" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="ПАУЗА" FontFamily="Consolas" FontSize="44" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                <Button Style="{StaticResource NeonButton}" Content="ПРОДОЛЖИТЬ  [Esc]" Click="Resume_Click" />
                <Button x:Name="PauseCalibrateButton" Style="{StaticResource NeonButton}" Content="КАЛИБРОВАТЬ КАМЕРУ  [F5]"
                        Click="PauseCalibrate_Click" Visibility="Collapsed" />
                <Button Style="{StaticResource NeonButton}" Content="В МЕНЮ" Click="Menu_Click" />
            </StackPanel>
        </Border>

        <!-- ───────── Итоги ───────── -->
        <Border x:Name="GameOverPanel" Grid.RowSpan="2" Style="{StaticResource PanelStyle}" Width="520" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="GameOverTitle" Text="КОРАБЛЬ УНИЧТОЖЕН" FontFamily="Consolas" FontSize="36" FontWeight="Bold"
                           Foreground="#FF4D6D" HorizontalAlignment="Center" />
                <TextBlock x:Name="ResultStars" FontFamily="Consolas" FontSize="34" Foreground="{StaticResource OrangeBrush}"
                           HorizontalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="NewRecordText" Text="★  НОВЫЙ РЕКОРД  ★" FontFamily="Consolas" FontSize="20"
                           FontWeight="Bold" Foreground="{StaticResource OrangeBrush}" HorizontalAlignment="Center"
                           Margin="0,8,0,0" Visibility="Collapsed" />
                <Grid x:Name="StatsGrid" Margin="0,18,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                </Grid>
                <TextBlock x:Name="TroubleText" FontFamily="Consolas" FontSize="14" Foreground="{StaticResource DimBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,10" />
                <Button x:Name="NextLessonButton" Style="{StaticResource NeonButton}" Content="СЛЕДУЮЩИЙ УРОК  [Enter]"
                        Click="NextLesson_Click" Visibility="Collapsed" />
                <Button x:Name="ContinueOverButton" Style="{StaticResource NeonButton}" Click="Continue_Click"
                        Visibility="Collapsed" />
                <Button x:Name="RestartButton" Style="{StaticResource NeonButton}" Content="ИГРАТЬ СНОВА  [Enter]" Click="Start_Click" />
                <Button Style="{StaticResource NeonButton}" Content="В МЕНЮ  [Esc]" Click="Menu_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
