<Window x:Class="TypeStrike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:game="clr-namespace:TypeStrike.Game"
        Title="TypeStrike — космический тренажёр скоростной печати"
        Width="1200" Height="820" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#03040C"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <game:GameView x:Name="View" Focusable="True" FocusVisualStyle="{x:Null}" />
        <!-- Подсказка: слово, клавиатура с зонами пальцев, руки -->
        <game:KeyboardHint x:Name="Hints" Grid.Row="1" Height="230" Visibility="Collapsed" />

        <!-- ───────── Главное меню ───────── -->
        <ScrollViewer x:Name="MenuPanel" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" Focusable="False">
        <Border Style="{StaticResource PanelStyle}" Width="560" Margin="20">
            <StackPanel>
                <TextBlock Text="TYPESTRIKE" FontFamily="Consolas" FontSize="56" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#5CE1FF" BlurRadius="24" ShadowDepth="0" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="космический тренажёр скоростной печати" FontFamily="Consolas" FontSize="15"
                           Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />

                <TextBlock Style="{StaticResource CaptionStyle}" Text="РЕЖИМ" />
                <UniformGrid Columns="2">
                    <RadioButton x:Name="ModeLessons" GroupName="Mode" Style="{StaticResource ChipStyle}"
                                 Content="Уроки слепой печати" IsChecked="True" Click="Mode_Click" />
                    <RadioButton x:Name="ModeFree" GroupName="Mode" Style="{StaticResource ChipStyle}"
                                 Content="Свободная игра" Click="Mode_Click" />
                </UniformGrid>

                <TextBlock Style="{StaticResource CaptionStyle}" Text="СЛОВА" />
                <UniformGrid Columns="3">
                    <RadioButton x:Name="LangEn" GroupName="Lang" Style="{StaticResource ChipStyle}"
                                 Content="English" IsChecked="True" Click="Lang_Click" />
                    <RadioButton x:Name="LangRu" GroupName="Lang" Style="{StaticResource ChipStyle}"
                                 Content="Русский" Click="Lang_Click" />
                    <RadioButton x:Name="LangCustom" GroupName="Lang" Style="{StaticResource ChipStyle}"
                                 Content="Свой файл…" Click="LangCustom_Click" />
                </UniformGrid>
                <TextBlock x:Name="CustomInfo" Visibility="Collapsed" FontFamily="Consolas" FontSize="13"
                           Foreground="{StaticResource OrangeBrush}" Margin="4,4,0,0" TextTrimming="CharacterEllipsis" />

                <Border x:Name="LessonPanel" Margin="0,12,0,0" Padding="12,10" CornerRadius="8"
                        Background="#111A2E" BorderBrush="#2B3D5E" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource NeonButton}" FontSize="16"
                                    Padding="12,4" Margin="0" Content="◀" Click="LessonPrev_Click" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource NeonButton}" FontSize="16"
                                    Padding="12,4" Margin="0" Content="▶" Click="LessonNext_Click" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="LessonTitle" FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock x:Name="LessonLetters" FontFamily="Consolas" FontSize="13"
                                           Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="LessonStars" FontFamily="Consolas" FontSize="20"
                                   Foreground="{StaticResource OrangeBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock x:Name="LessonTip" FontFamily="Consolas" FontSize="13" Foreground="#C8D3EA"
                                   TextWrapping="Wrap" Margin="0,6,0,0" TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource CaptionStyle}" Text="СЛОЖНОСТЬ" />
                <UniformGrid Columns="3">
                    <RadioButton x:Name="DiffEasy" GroupName="Diff" Style="{StaticResource ChipStyle}"
                                 Content="Лёгкая" Click="Difficulty_Click" />
                    <RadioButton x:Name="DiffNormal" GroupName="Diff" Style="{StaticResource ChipStyle}"
                                 Content="Нормальная" IsChecked="True" Click="Difficulty_Click" />
                    <RadioButton x:Name="DiffHard" GroupName="Diff" Style="{StaticResource ChipStyle}"
                                 Content="Хардкор" Click="Difficulty_Click" />
                </UniformGrid>
                <TextBlock x:Name="DifficultyInfo" FontFamily="Consolas" FontSize="13"
                           Foreground="{StaticResource DimBrush}" Margin="4,4,0,0" />

                <CheckBox x:Name="HintsBox" Content="Подсказка: клавиатура и пальцы" IsChecked="True" Focusable="False"
                          Foreground="#C8D3EA" FontFamily="Consolas" FontSize="14" Margin="4,16,0,0" />
                <CheckBox x:Name="SoundBox" Content="Звуковые эффекты" IsChecked="True" Focusable="False"
                          Foreground="#C8D3EA" FontFamily="Consolas" FontSize="14" Margin="4,8,0,0" />

                <Button Style="{StaticResource NeonButton}" Margin="0,20,0,6" Click="Start_Click"
                        Content="▶  СТАРТ   [Enter]" />
                <TextBlock x:Name="BestText" FontFamily="Consolas" FontSize="14" Foreground="{StaticResource OrangeBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />

                <Border Height="1" Background="#2B3D5E" Margin="0,18,0,12" />
                <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{StaticResource DimBrush}"
                           TextWrapping="Wrap" LineHeight="20">
                    <Run Text="Сбивайте вражеские корабли, печатая слова на них. Первая буква захватывает ближайшую цель — допечатайте слово до конца, не промахиваясь." />
                    <LineBreak />
                    <Run Text="Уроки: 4 волны с новыми буквами. Первая волна — упражнения, дальше слова только из изученных букв. Для зачёта нужна точность от 90%: ★ 90%, ★★ 94%, ★★★ 97%." />
                    <LineBreak />
                    <Run Foreground="White" Text="Enter" /><Run Text=" — ЭМИ-импульс (отталкивает врагов)   " />
                    <Run Foreground="White" Text="Backspace" /><Run Text=" — сменить цель   " />
                    <Run Foreground="White" Text="Esc" /><Run Text=" — пауза" />
                </TextBlock>
            </StackPanel>
        </Border>
        </ScrollViewer>

        <!-- ───────── Пауза ───────── -->
        <Border x:Name="PausePanel" Grid.RowSpan="2" Style="{StaticResource PanelStyle}" Width="380" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="ПАУЗА" FontFamily="Consolas" FontSize="44" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                <Button Style="{StaticResource NeonButton}" Content="ПРОДОЛЖИТЬ  [Esc]" Click="Resume_Click" />
                <Button Style="{StaticResource NeonButton}" Content="В МЕНЮ" Click="Menu_Click" />
            </StackPanel>
        </Border>

        <!-- ───────── Итоги ───────── -->
        <Border x:Name="GameOverPanel" Grid.RowSpan="2" Style="{StaticResource PanelStyle}" Width="520" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="GameOverTitle" Text="КОРАБЛЬ УНИЧТОЖЕН" FontFamily="Consolas" FontSize="36" FontWeight="Bold"
                           Foreground="#FF4D6D" HorizontalAlignment="Center" />
                <TextBlock x:Name="ResultStars" FontFamily="Consolas" FontSize="34" Foreground="{StaticResource OrangeBrush}"
                           HorizontalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="NewRecordText" Text="★  НОВЫЙ РЕКОРД  ★" FontFamily="Consolas" FontSize="20"
                           FontWeight="Bold" Foreground="{StaticResource OrangeBrush}" HorizontalAlignment="Center"
                           Margin="0,8,0,0" Visibility="Collapsed" />
                <Grid x:Name="StatsGrid" Margin="0,18,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                </Grid>
                <TextBlock x:Name="TroubleText" FontFamily="Consolas" FontSize="14" Foreground="{StaticResource DimBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,10" />
                <Button x:Name="NextLessonButton" Style="{StaticResource NeonButton}" Content="СЛЕДУЮЩИЙ УРОК  [Enter]"
                        Click="NextLesson_Click" Visibility="Collapsed" />
                <Button x:Name="RestartButton" Style="{StaticResource NeonButton}" Content="ИГРАТЬ СНОВА  [Enter]" Click="Start_Click" />
                <Button Style="{StaticResource NeonButton}" Content="В МЕНЮ  [Esc]" Click="Menu_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
